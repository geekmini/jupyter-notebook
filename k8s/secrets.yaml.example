# Example secrets file - DO NOT commit the actual secrets.yaml!
# Copy this to secrets.yaml and fill in your actual values

apiVersion: v1
kind: Secret
metadata:
  name: airflow-secrets
  namespace: airflow
type: Opaque
stringData:
  # OpenRouter API key for LLM calls
  openrouter-api-key: "your-openrouter-api-key-here"

  # MinIO secret key (password)
  minio-secret-key: "minioadmin"

  # Webserver secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
  webserver-secret-key: "your-webserver-secret-key-here"
